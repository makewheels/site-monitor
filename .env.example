# AI summaries
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# Feishu Open API delivery
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
FEISHU_CHAT_ID=
FEISHU_BASE_URL=https://open.feishu.cn

# Tencent Cloud MongoDB running on the Lighthouse instance
SITE_MONITOR_MONGO_URI=mongodb://<username>:<password>@<database-host>:<port>/site_monitor?authSource=admin
SITE_MONITOR_DB_NAME=site_monitor

# Optional persistent runtime directory
SITE_MONITOR_RUNTIME_DIR=
