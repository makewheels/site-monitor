{
  "sites": [
    {
      "name": "Claude Blog",
      "url": "https://claude.com/blog",
      "article_selector": "[role=\"tabpanel\"] li",
      "title_selector": "h2, h3, a",
      "link_selector": "a[href^=\"/blog/\"]",
      "check_interval": 86400,
      "enabled": true
    },
    {
      "name": "Anthropic Engineering",
      "url": "https://www.anthropic.com/engineering",
      "article_selector": "article[class*=\"ArticleList\"]",
      "title_selector": "h2, h3",
      "link_selector": "a[href*=\"/engineering/\"]",
      "check_interval": 86400,
      "enabled": true
    },
    {
      "name": "GitHub Trending",
      "url": "https://github.com/trending",
      "article_selector": "article.Box-row",
      "title_selector": "h2 a",
      "link_selector": "h2 a",
      "description_selector": "p.col-9",
      "check_interval": 86400,
      "enabled": true,
      "daily_summary": true
    }
  ],
  "monitor_sources": {
    "anthropic_engineering": {
      "rsshub_urls": [
        "https://rsshub.app/anthropic/engineering",
        "https://rsshub.ktachibana.party/anthropic/engineering"
      ],
      "fallback_url": "https://www.anthropic.com/engineering"
    },
    "langchain_blog": {
      "feed_urls": [
        "https://www.langchain.com/blog/rss.xml"
      ],
      "fallback_url": "https://www.langchain.com/blog"
    }
  },
  "rss_feeds": [
    {"key": "huggingface_blog", "name": "Hugging Face Blog", "urls": ["https://huggingface.co/blog/feed.xml"], "limit": 20},
    {"key": "openai_news", "name": "OpenAI News", "urls": ["https://openai.com/news/rss.xml"], "limit": 20},
    {"key": "google_research", "name": "Google Research", "urls": ["https://research.google/blog/rss/"], "limit": 20},
    {"key": "metr", "name": "METR", "urls": ["https://metr.org/feed.xml"], "limit": 20},
    {"key": "swe_bench", "name": "SWE-bench", "urls": ["https://github.com/swe-bench/SWE-bench/releases.atom"], "limit": 20},
    {"key": "trail_of_bits", "name": "Trail of Bits", "urls": ["https://blog.trailofbits.com/feed/"], "limit": 20},
    {"key": "owasp_llm_top10", "name": "OWASP LLM Top 10", "urls": ["https://github.com/OWASP/www-project-top-10-for-large-language-model-applications/releases.atom"], "limit": 20}
  ],
  "postprocessors": {
    "github_trending": [
      {
        "enabled": true,
        "module": "site_monitor.postprocessors.trending_summary",
        "function": "summarize"
      },
      {
        "enabled": false,
        "module": "site_monitor.postprocessors.trending_project_intro",
        "function": "enrich",
        "options": {
          "page_base_url": "https://site-monitor.a4.fit/projects",
          "workers": 2,
          "max_readme_chars": 8000,
          "fetch_timeout": 20,
          "request_timeout": 120
        }
      }
    ]
  },
  "article_enrichment": {
    "enabled": true,
    "required": true,
    "topics": [
      "anthropic_engineering",
      "openai_news",
      "langchain_blog",
      "huggingface_blog",
      "google_research",
      "metr",
      "trail_of_bits"
    ],
    "batch_size": 4,
    "fetch_workers": 4,
    "fetch_timeout": 15,
    "max_source_chars": 6000,
    "request_timeout": 120,
    "retries": 3
  },
  "delivery": {
    "enabled": true,
    "provider": "feishu",
    "markdown": true,
    "max_chars": 12000
  },
  "runtime": {
    "state_dir": "runtime/state",
    "pending_dir": "runtime/pending",
    "logs_dir": "runtime/logs",
    "tmp_dir": "runtime/tmp"
  },
  "check_interval": 86400,
  "notifier": {
    "type": "console"
  }
}
