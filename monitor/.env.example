# Provider-switchable OpenAI-compatible model configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/compatible-mode/v1
LLM_MODEL=

# Optional multi-provider failover. When set, LLM_PROVIDER_ORDER wins over the
# single-provider vars above: providers are tried left-to-right, falling back on
# error/timeout/non-2xx. Supported names: baidu, aliyun, deepseek.
# Example: LLM_PROVIDER_ORDER=baidu,aliyun
LLM_PROVIDER_ORDER=
# baidu (Qianfan / TokenPlan)
BAIDU_LLM_API_KEY=
BAIDU_LLM_BASE_URL=
BAIDU_LLM_MODEL=
# aliyun (DashScope)
ALIYUN_LLM_API_KEY=
ALIYUN_LLM_BASE_URL=
ALIYUN_LLM_MODEL=
# deepseek
DEEPSEEK_LLM_API_KEY=
DEEPSEEK_LLM_BASE_URL=
DEEPSEEK_LLM_MODEL=

# Feishu Open API delivery
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
FEISHU_CHAT_ID=
FEISHU_BASE_URL=https://open.feishu.cn

# Dedicated application account, never MongoDB root
SITE_MONITOR_MONGO_URI=
SITE_MONITOR_DB_NAME=site_monitor
SITE_MONITOR_RUNTIME_DIR=

# Optional structured report upload API
SITE_MONITOR_CLOUD_API_URL=
SITE_MONITOR_UPLOAD_TOKEN=
