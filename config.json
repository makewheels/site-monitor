{
  "sites": [
    {
      "name": "Claude Blog",
      "url": "https://claude.com/blog",
      "article_selector": "[role=\"tabpanel\"] li",
      "title_selector": "h2, h3, a",
      "link_selector": "a[href^=\"/blog/\"]",
      "check_interval": 3600,
      "enabled": true
    },
    {
      "name": "Anthropic Engineering",
      "url": "https://www.anthropic.com/engineering",
      "article_selector": "article[class*=\"ArticleList\"]",
      "title_selector": "h2, h3",
      "link_selector": "a[href*=\"/engineering/\"]",
      "check_interval": 3600,
      "enabled": true
    },
    {
      "name": "Claude Code Changelog",
      "url": "https://github.com/anthropics/claude-code/releases",
      "article_selector": ".release",
      "title_selector": "a.release-link",
      "link_selector": "a.release-link",
      "check_interval": 3600,
      "enabled": true
    },
    {
      "name": "GitHub Trending",
      "url": "https://github.com/trending",
      "article_selector": "article.Box-row",
      "title_selector": "h2 a",
      "link_selector": "h2 a",
      "description_selector": "p.col-9",
      "check_interval": 86400,
      "enabled": true,
      "daily_summary": true
    }
  ],
  "monitor_sources": {
    "anthropic_engineering": {
      "rsshub_urls": [
        "https://rsshub.app/anthropic/engineering",
        "https://rsshub.ktachibana.party/anthropic/engineering"
      ],
      "fallback_url": "https://www.anthropic.com/engineering"
    },
    "claude_code_changelog": {
      "rsshub_urls": [
        "https://rsshub.app/claude/code/changelog",
        "https://rsshub.ktachibana.party/claude/code/changelog"
      ],
      "github_releases_url": "https://github.com/anthropics/claude-code/releases",
      "github_releases_api": "https://api.github.com/repos/anthropics/claude-code/releases?per_page=5",
      "npm_package": "@anthropic-ai/claude-code"
    },
    "github_copilot_cli_changelog": {
      "atom_url": "https://github.com/github/copilot-cli/commits/main/changelog.md.atom",
      "raw_url": "https://raw.githubusercontent.com/github/copilot-cli/main/changelog.md"
    }
  },
  "check_interval": 3600,
  "notifier": {
    "type": "console"
  }
}
