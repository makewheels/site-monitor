      "article_selector": "article[class*=\"ArticleList\"]",
      "title_selector": "h2, h3",
      "link_selector": "a[href*=\"/engineering/\"]",
      "check_interval": 3600,
      "enabled": true
    },
    {
      "name": "Claude Code Changelog",
      "url": "https://github.com/anthropics/claude-code/releases",
